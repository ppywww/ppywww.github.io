---
/**
 * BaseLayout · 全站页面外壳
 * 两个关键职责：
 *   ① SEO：canonical / Open Graph / Twitter Card / JSON-LD
 *   ② **零闪烁深色模式**：<head> 首个可执行节点内联脚本，首帧前给 <html> 打上 .dark
 */
import { SITE } from '../consts';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  /** 页面标题；不传则用「站点名 · 一句话描述」 */
  title?: string;
  description?: string;
  /** canonical 用的站内路径，默认取当前 URL */
  path?: string;
  /** OG 图（可选；MVP 暂不生成 OG 图，传了才输出） */
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** 追加的 JSON-LD 结构化数据 */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  image,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

// 首页 <title> 只放站名；副标题较长，交给 description / OG description 承载
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
// new URL(path, site) 会自动补全为绝对地址；用户站点走根路径，无需拼 base
const canonical = new URL(path, SITE.url).href;
const ogImage = image ? new URL(image, SITE.url).href : undefined;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    description: SITE.description,
    url: SITE.url,
    inLanguage: SITE.lang,
    author: { '@type': 'Person', name: SITE.author },
  },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
// 防 </script> 提前闭合
const jsonLdText = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />

    <!--
      ⚠️ 这段脚本必须留在 <head> 最前面，且不得改成 is:inline 之外的形式。
      它同步执行于任何渲染之前：先读 localStorage['pref-theme']，无值则回落 prefers-color-scheme，
      在**首帧前**给 <html> 加上 .dark —— 这是「深色模式无白闪」的全部实现（PRD F-06 / AC-3）。
    -->
    <script is:inline>
      (function () {
        try {
          var KEY = 'pref-theme';
          var stored = localStorage.getItem(KEY);
          var theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          var root = document.documentElement;
          root.classList.toggle('dark', theme === 'dark');
          root.classList.toggle('light', theme === 'light');
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
        } catch (e) {
          /* localStorage 被禁用：静默回落，交由 CSS 的 prefers-color-scheme */
        }
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!--
      浏览器地址栏配色。<meta> 无法引用 CSS 变量，故此处色值与 tokens.css
      的 --color-bg 亮/暗值同步（改配色时记得一起改）。
    -->
    <meta name="theme-color" content="#FCFCFD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1115" media="(prefers-color-scheme: dark)" />

    <script type="application/ld+json" set:html={jsonLdText}></script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <slot />

    <!-- 主题切换：原生 JS + 事件委托，零框架、零首屏依赖 -->
    <script>
      (function () {
        var KEY = 'pref-theme';
        var root = document.documentElement;

        function syncButtons() {
          var isDark = root.classList.contains('dark');
          var label = isDark ? '切换到浅色模式' : '切换到深色模式';
          document.querySelectorAll('[data-theme-toggle]').forEach(function (el) {
            el.setAttribute('aria-pressed', String(isDark));
            el.setAttribute('aria-label', label);
            el.setAttribute('title', label);
          });
        }

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!(target instanceof Element) || !target.closest('[data-theme-toggle]')) return;

          var next = root.classList.contains('dark') ? 'light' : 'dark';
          root.classList.toggle('dark', next === 'dark');
          root.classList.toggle('light', next === 'light');
          root.dataset.theme = next;
          root.style.colorScheme = next;
          try {
            localStorage.setItem(KEY, next);
          } catch (e) {
            /* 存不进就算了，不阻断切换 */
          }
          syncButtons();
        });

        syncButtons();
      })();
    </script>
  </body>
</html>
