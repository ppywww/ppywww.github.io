---
/**
 * 标签云 /tags/ —— PRD §7.4 / F-04
 * 标签从文章自动聚合 + 计数；数量倒序，同数量按名称排序（构建产物稳定可复现）。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TermPill from '../../components/TermPill.astro';
import { SITE } from '../../consts';

const posts = await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true));

// 与标签详情页共用同一份 posts，保证「计数 = 实际文章数」
const counts = new Map<string, number>();
for (const post of posts) {
  // 按「每篇文章计一次」去重：同一篇里重复写同一个标签不会把计数抬高
  for (const tag of new Set(post.data.tags)) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout
  title="标签"
  description={`${SITE.title} 的全部标签，共 ${tags.length} 个，按文章数量排列。`}
>
  <Header />

  <main class="main" id="main-content">
    <div class="container">
      <div class="page-head">
        <h1 class="page-title">标签</h1>
        <p class="page-lead">共 {tags.length} 个标签、{posts.length} 篇文章，按文章数量从多到少排列。</p>
      </div>

      {
        tags.length === 0 ? (
          <div class="empty">
            <p class="empty__title">还没有标签</p>
            <p>文章 Front-Matter 里的 tags 会自动聚合成这里的标签云。</p>
            <p>
              <a href="/posts/">浏览全部文章</a>
            </p>
          </div>
        ) : (
          <ul class="term-cloud">
            {tags.map(([tag, count]) => (
              <li>
                <TermPill label={tag} href={`/tags/${encodeURIComponent(tag)}/`} count={count} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-head {
    margin-bottom: var(--space-9);
  }

  .page-title {
    margin-bottom: var(--space-3);
  }

  .page-lead {
    color: var(--color-text-secondary);
    max-width: var(--content-width);
  }

  .term-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }
</style>
