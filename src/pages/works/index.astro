---
/**
 * 作品集 /works/ —— PRD §7.6 / F-07
 * 卡片网格：featured 优先 → order 升序（越小越靠前）→ 日期倒序；封面、技术栈、源码/Demo 链接。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';
import { SITE } from '../../consts';

const works = (
  await getCollection('works', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order ||
    (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);

const featuredCount = works.filter((work) => work.data.featured).length;
---

<BaseLayout
  title="作品"
  description={`${SITE.title} 的作品与项目集，共 ${works.length} 个，含技术栈与源码、Demo 链接。`}
>
  <Header />

  <main class="main" id="main-content">
    <div class="container">
      {/* 内容列（换肤层 .content）：与首页同宽 —— 内容 768px + 两侧 --gap，卡片宽度全站一致 */}
      <div class="content">
        <div class="page-head">
          <h1 class="page-title">作品</h1>
          <p class="page-lead">
            共 {works.length} 个项目{featuredCount > 0 && `，其中 ${featuredCount} 个精选`}。
          </p>
        </div>

        {
          works.length === 0 ? (
            <div class="empty">
              <p class="empty__title">还没有作品</p>
              <p>
                把 Markdown 放进 <code>src/content/works/</code>，这里会自动生成作品网格。
              </p>
              <p>
                <a href="/">返回首页</a>
              </p>
            </div>
          ) : (
            <ul class="work-grid">
              {works.map((work) => (
                <WorkCard work={work} />
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-head {
    margin-bottom: var(--space-9);
  }

  .page-title {
    margin-bottom: var(--space-3);
  }

  .page-lead {
    color: var(--color-text-secondary);
    max-width: var(--content-width);
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  /* ≥900px 双列（设计系统 §4.2：作品页网格 ≥2 列） */
  @media (min-width: 900px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
