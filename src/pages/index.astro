---
/**
 * 首页（PRD §7.1 / §4 J1，v1.1-BC 骨架）
 *
 * 结构：ProfileCard（这是谁）→ .content 内容列里的「最新文章」（这里有什么）。
 * · bodyClass="list"：换肤层用 body.list 切列表页底色（含吸顶页头底色同步）。
 * · profile 块与文章列表**同在 .content 内容列内**，保证两者左边缘对齐
 *   （v1.1 修正：profile 原先在 .container 上，导致它比文章卡片左出约 128px）。
 *   profile 文案宽度 519px < 768px 列宽，副标题单行不受影响。
 * 0 篇文章时必须仍可正常构建：走空态分支，不报错、不白屏。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import ProfileCard from '../components/ProfileCard.astro';

// 生产构建过滤草稿；本地 dev 保留草稿便于预览
const posts = (
  await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout bodyClass="list">
  <Header />

  <main class="main" id="main-content">
    <div class="container">
      <div class="content">
        <ProfileCard />

        <section aria-labelledby="latest-title">
          <h2 class="section-title" id="latest-title">最新文章</h2>

          {
            posts.length === 0 ? (
              <div class="empty">
                <p class="empty__title">还没有文章</p>
                <p>
                  把 Markdown 放进 <code>src/content/posts/</code>，提交后自动上线。
                </p>
              </div>
            ) : (
              <ul class="card-list">
                {posts.map((post) => (
                  <PostCard post={post} />
                ))}
              </ul>
            )
          }
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
