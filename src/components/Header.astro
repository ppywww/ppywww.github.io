---
import { NAV, SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

/** 当前导航项判定：'/' 必须全等，其余按前缀匹配（/posts/ 高亮 /posts/xxx/） */
function isCurrent(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">{SITE.title}</a>

    <div class="site-header__nav">
      <nav aria-label="主导航">
        <ul class="nav">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-header__actions">
        <!-- 搜索入口（设计系统 §6.1）：Alt+/ 快捷键属 P1（F-18），MVP 不实现，故 aria-label 不承诺快捷键 -->
        <a class="icon-btn" href="/search/" aria-label="站内搜索" title="站内搜索">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.6-3.6"></path>
          </svg>
        </a>

        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  /*
    触控目标修复（task-14 第 2 项 / WCAG 2.2 AA 2.5.8 ≥24×24）：
    站点名是纯文本链接，原来命中的只有文字行盒（≈17px 高），Lighthouse 报 a.brand 不达标。
    用 padding 把命中区撑到 ≈28px；父级是 align-items: center 的 flex，不影响视觉位置。
  */
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-block: var(--space-1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  /* 图标按钮：视觉 36×36，图标 18×18（设计系统 §6.0 / §6.14） */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  .icon-btn svg {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) and (pointer: fine) {
    .icon-btn:hover {
      color: var(--color-text);
      background: var(--color-surface-2);
    }
  }

  .icon-btn:active {
    background: var(--color-surface-2);
  }

  /* 触控命中区 ≥44×44（§6.0） */
  @media (pointer: coarse) {
    .icon-btn {
      width: 44px;
      height: 44px;
    }
  }
</style>
