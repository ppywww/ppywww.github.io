---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/date';
import { readingTime } from '../lib/reading-time';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, date, lastmod, categories, tags, draft } = post.data;
const minutes = readingTime(post.body ?? '');
---

<li class="card post-card">
  <h3 class="post-card__title">
    <a href={`/posts/${post.id}/`}>{title}</a>
  </h3>
  <p class="post-card__desc">{description}</p>

  <div class="meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="meta__sep" aria-hidden="true">·</span>
    <span>{minutes} 分钟</span>
    <span class="meta__sep" aria-hidden="true">·</span>
    <span>{categories[0]}</span>
    {lastmod && <><span class="meta__sep" aria-hidden="true">·</span><span>更新于 {formatDate(lastmod)}</span></>}
    {draft && <><span class="meta__sep" aria-hidden="true">·</span><span>草稿</span></>}
  </div>

  {
    tags.length > 0 && (
      <ul class="tag-list" style="margin-top: var(--space-4)">
        {tags.map((tag) => (
          <li>
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>
