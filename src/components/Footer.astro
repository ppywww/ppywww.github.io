---
import { SITE, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>© {year} {SITE.author} · {SITE.title}</p>
    <ul class="nav">
      {SOCIAL.map((item) => (
        <li>
          <a href={item.href} rel="noopener">{item.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>
