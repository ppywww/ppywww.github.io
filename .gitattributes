# 统一换行符：仓库内一律 LF，避免 Windows 上出现 CRLF 噪音
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary

# 构建产物与依赖在 .gitignore 中排除，这里额外标注语言统计
dist/ linguist-generated=true
package-lock.json linguist-generated=true
